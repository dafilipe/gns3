auto swp1
iface swp1 inet static
    address 10.3.12.1/30

# Link r1-r3
auto swp2
iface swp2 inet static
    address 10.3.13.1/30

# LAN pc1
auto swp3
iface swp3 inet static
    address 172.16.1.1/24

# Loopback de routing
    post-up ip address add 10.255.3.1/32 dev lo
