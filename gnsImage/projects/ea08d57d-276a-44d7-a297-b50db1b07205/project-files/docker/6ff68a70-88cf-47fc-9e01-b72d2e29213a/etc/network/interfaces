# Management interface (written by cgr_lab.py)
auto lo
iface lo inet loopback

auto eth0
iface eth0 inet static
    address 192.168.100.11
    netmask 255.255.255.0

# ---- your data-plane configuration goes below (ifupdown2 syntax), then: ifreload -a
auto swp1
iface swp1
    bridge-vids 10

auto swp2
iface swp2
    bridge-access 10

auto bridge
iface bridge
    bridge-vlan-aware yes
    bridge-ports swp1 swp2
    bridge-vids 10
