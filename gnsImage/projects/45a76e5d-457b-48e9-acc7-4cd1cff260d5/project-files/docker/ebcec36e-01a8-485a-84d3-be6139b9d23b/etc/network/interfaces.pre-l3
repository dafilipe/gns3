# Management interface (written by cgr_lab.py)
auto lo
iface lo inet loopback

auto eth0
iface eth0 inet static
    address 192.168.200.14
    netmask 255.255.255.0

# ---- your data-plane configuration goes below (ifupdown2 syntax), then: ifreload -a

# LACP para Access1
auto bond1
iface bond1
    bond-slaves swp1 swp2
    bond-mode 802.3ad
    bond-miimon 100
    bridge-vids 2 3

# LACP para Access2
auto bond2
iface bond2
    bond-slaves swp3 swp4
    bond-mode 802.3ad
    bond-miimon 100
    bridge-vids 2 3

# LACP para Distribution2
auto bond3
iface bond3
    bond-slaves swp5 swp6
    bond-mode 802.3ad
    bond-miimon 100
    bridge-vids 2 3

# Bridge VLAN-aware
auto bridge
iface bridge
    bridge-vlan-aware yes
    bridge-ports bond1 bond2 bond3
    bridge-vids 2 3
    bridge-stp on
    bridge-stp-priority 4096

auto bridge.2
iface bridge.2
    address 10.8.2.2/24

auto bridge.3
iface bridge.3
    address 10.8.3.2/24
