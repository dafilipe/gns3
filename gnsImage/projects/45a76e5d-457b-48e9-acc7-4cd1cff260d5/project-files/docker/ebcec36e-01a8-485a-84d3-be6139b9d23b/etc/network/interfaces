# Management interface (written by cgr_lab.py)
auto lo
iface lo inet loopback
	address 10.8.255.11/32

auto eth0
iface eth0 inet static
    address 192.168.200.14
    netmask 255.255.255.0

# ---- your data-plane configuration goes below (ifupdown2 syntax), then: ifreload -a

# LACP para Access1
auto bond1
iface bond1
    bond-slaves swp1 swp2
    bond-mode 802.3ad
    bond-miimon 100
    bridge-vids 2 3

# LACP para Access2
auto bond2
iface bond2
    bond-slaves swp3 swp4
    bond-mode 802.3ad
    bond-miimon 100
    bridge-vids 2 3

# LACP para Distribution2
auto bond3
iface bond3
    bond-slaves swp5 swp6
    bond-mode 802.3ad
    bond-miimon 100
    bridge-vids 2 3

# Bridge VLAN-aware
auto bridge
iface bridge
    bridge-vlan-aware yes
    bridge-ports bond1 bond2 bond3
    bridge-vids 2 3
    bridge-stp on
    bridge-bridgeprio 4096

auto bridge.2
iface bridge.2
    address 10.8.2.2/24
    address-virtual 00:00:5e:00:01:02 10.8.2.1/24

auto bridge.3
iface bridge.3
    address 10.8.3.2/24
    address-virtual 00:00:5e:00:01:03 10.8.3.1/24

# Layer 3 links to Spine routers
auto swp7
iface swp7 inet static
    address 10.8.10.0/31

auto swp8
iface swp8 inet static
    address 10.8.10.2/31

auto swp9
iface swp9 inet static
    address 10.8.10.4/31

auto swp10
iface swp10 inet static
    address 10.8.10.6/31
